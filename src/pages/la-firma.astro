---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
	title={t('firm.title')}
	description={t('firm.description')}
	navbarDarkMode={true}
>

	<!-- Hero -->
	<section class="relative min-h-[56vh] flex items-center justify-center text-center bg-dark-slate text-white overflow-hidden" style="padding-top: clamp(80px, 12vw, 140px); padding-bottom: clamp(80px, 12vw, 140px);">
		<div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(circle at 70% 30%, rgba(138,95,42,0.15), transparent 60%)"></div>
		<div class="relative z-10 max-w-220 mx-auto px-6">
			<span class="block text-xs tracking-[0.22em] uppercase text-bronze mb-6">{t('firm.hero.eyebrow')}</span>
			<h1 class="font-light tracking-wide mb-7" style="font-size: clamp(40px, 6vw, 68px);">{t('firm.title')}</h1>
			<div class="w-16 h-0.75 bg-bronze mx-auto mb-7"></div>
			<p class="font-light leading-loose max-w-160 mx-auto" style="font-size: clamp(15px, 1.5vw, 18px); color: rgba(255,255,255,0.85);">{t('firm.hero.subtitle')}</p>
		</div>
	</section>

	<!-- Intro -->
	<section class="bg-light-gray py-16 md:py-24 px-6 md:px-12 lg:px-20">
		<div class="max-w-360 mx-auto">
			<div class="grid grid-cols-1 md:grid-cols-[1fr_1.4fr] gap-10 md:gap-20 items-start">
				<div>
					<h2 class="text-dark-slate text-2xl md:text-3xl font-semibold tracking-wide uppercase">{t('firm.title')}</h2>
					<div class="w-14 h-0.75 bg-bronze mt-3"></div>
				</div>
				<div class="space-y-4 text-dark-slate font-light leading-relaxed text-base md:text-lg">
					<p set:html={t('firm.p1')} />
					<p set:html={t('firm.p2')} />
					<p>{t('firm.p3')}</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Enfoque y alcance -->
	<section class="bg-white py-16 md:py-24 px-6 md:px-12 lg:px-20">
		<div class="max-w-360 mx-auto">
			<div class="grid grid-cols-1 md:grid-cols-[1fr_1.4fr] gap-10 md:gap-20 items-start">
				<div>
					<h2 class="text-dark-slate text-2xl md:text-3xl font-semibold tracking-wide uppercase">{t('firm.enfoque.title')}</h2>
					<div class="w-14 h-0.75 bg-bronze mt-3"></div>
				</div>
				<div class="space-y-4 text-dark-slate font-light leading-relaxed text-base md:text-lg">
					<p>{t('firm.enfoque.p1')}</p>
					<p>{t('firm.enfoque.p2')}</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Consultoría corporativa -->
	<section class="bg-dark-slate py-16 md:py-24 px-6 md:px-12 lg:px-20">
		<div class="max-w-360 mx-auto">
			<div class="grid grid-cols-1 md:grid-cols-[1fr_1.4fr] gap-10 md:gap-20 items-start">
				<div>
					<h2 class="text-white text-2xl md:text-3xl font-semibold tracking-wide uppercase">{t('firm.consultoria.title')}</h2>
					<div class="w-14 h-0.75 bg-bronze mt-3"></div>
				</div>
				<div class="space-y-4 font-light leading-relaxed text-base md:text-lg" style="color: rgba(255,255,255,0.8);">
					<p>{t('firm.consultoria.p1')}</p>
					<p>{t('firm.consultoria.p2')}</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Nuestra misión -->
	<section class="bg-light-gray py-16 md:py-24 px-6 text-center">
		<div class="max-w-190 mx-auto">
			<span class="block text-xs tracking-[0.22em] uppercase text-bronze mb-6">{t('firm.mision.title')}</span>
			<div class="w-14 h-0.75 bg-bronze mx-auto mb-8"></div>
			<p class="text-dark-slate font-light leading-snug" style="font-size: clamp(22px, 2.6vw, 32px);">«{t('firm.mision.p1')}»</p>
		</div>
	</section>

	<!-- CTA -->
	<section class="bg-white border-t border-gray-200 py-14 md:py-20 px-6 text-center">
		<h2 class="text-dark-slate text-2xl md:text-3xl font-semibold tracking-wide uppercase">{t('firm.cta.title')}</h2>
		<div class="w-14 h-0.75 bg-bronze mx-auto mt-3 mb-6"></div>
		<p class="font-light max-w-135 mx-auto mb-8 text-base md:text-lg" style="color: rgba(45,55,68,0.7);">{t('firm.cta.desc')}</p>
		<a href="/nuestro-equipo" class="inline-block bg-bronze text-white px-8 py-4 text-xs font-medium tracking-[0.14em] uppercase transition-colors hover:bg-[#704d20]">{t('firm.cta.btn')}</a>
	</section>

</Layout>
