---
export const prerender = false;

import { generateToken, getSessionCookie, verifyToken } from '../../lib/auth';

let error = '';

if (Astro.request.method === 'POST') {
	const formData = await Astro.request.formData();
	const key = (formData.get('key') as string)?.trim() ?? '';
	const secret = Astro.locals.runtime.env.ADMIN_SECRET_KEY;

	if (key && key === secret) {
		const token = await generateToken(secret);
		return new Response(null, {
			status: 302,
			headers: {
				'Set-Cookie': getSessionCookie(token),
				'Location': '/admin',
			},
		});
	}
	error = 'Clave incorrecta.';
}
---

<!doctype html>
<html lang="es">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Admin — Seibel Henríquez</title>
	<style>
		*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
		body {
			font-family: system-ui, sans-serif;
			background: #1a2028;
			color: #e8e4df;
			min-height: 100vh;
			display: flex;
			align-items: center;
			justify-content: center;
		}
		.card {
			background: #242c36;
			padding: 2.5rem;
			width: 100%;
			max-width: 400px;
			border-top: 3px solid #b8956a;
		}
		h1 { font-size: 1.25rem; font-weight: 300; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 0.5rem; }
		.subtitle { font-size: 0.8rem; color: #8a9099; margin-bottom: 2rem; }
		label { display: block; font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 0.4rem; }
		input[type="password"] {
			width: 100%;
			background: #1a2028;
			border: 1px solid #3a4452;
			color: #e8e4df;
			padding: 0.75rem 1rem;
			font-size: 0.9rem;
			outline: none;
			transition: border-color 0.2s;
		}
		input[type="password"]:focus { border-color: #b8956a; }
		.error {
			margin-top: 0.75rem;
			font-size: 0.8rem;
			color: #e57373;
		}
		button {
			margin-top: 1.5rem;
			width: 100%;
			background: #b8956a;
			color: white;
			border: none;
			padding: 0.75rem 1rem;
			font-size: 0.85rem;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			cursor: pointer;
			transition: opacity 0.2s;
		}
		button:hover { opacity: 0.85; }
	</style>
</head>
<body>
	<div class="card">
		<h1>Seibel Henríquez</h1>
		<p class="subtitle">Panel de administración</p>
		<form method="POST">
			<label for="key">Clave de acceso</label>
			<input type="password" id="key" name="key" required autofocus />
			{error && <p class="error">{error}</p>}
			<button type="submit">Ingresar</button>
		</form>
	</div>
</body>
</html>
