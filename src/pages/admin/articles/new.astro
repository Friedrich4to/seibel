---
export const prerender = false;

import { createArticle } from '../../../lib/db';
import { uploadFile, imageKey, pdfKey } from '../../../lib/r2';
import { verifyToken, getTokenFromRequest } from '../../../lib/auth';

const { DB, BUCKET, ADMIN_SECRET_KEY } = Astro.locals.runtime.env;

const sessionToken = getTokenFromRequest(Astro.request);
const authorized = !!(sessionToken && await verifyToken(sessionToken, ADMIN_SECRET_KEY));

let error = '';
let saved = false;

if (authorized && Astro.request.method === 'POST') {
	const formData = await Astro.request.formData();

	const slug = (formData.get('slug') as string)?.trim().toLowerCase().replace(/\s+/g, '-') ?? '';
	const order_num = parseInt(formData.get('order_num') as string) || 0;
	const title_es = (formData.get('title_es') as string)?.trim() ?? '';
	const title_en = (formData.get('title_en') as string)?.trim() || null;
	const description_es = (formData.get('description_es') as string)?.trim() ?? '';
	const description_en = (formData.get('description_en') as string)?.trim() || null;
	const image_alt_es = (formData.get('image_alt_es') as string)?.trim() ?? '';
	const image_alt_en = (formData.get('image_alt_en') as string)?.trim() || null;
	const imageFile = formData.get('image') as File | null;
	const pdfFile = formData.get('pdf') as File | null;

	if (!slug || !title_es || !description_es || !image_alt_es) {
		error = 'Completa todos los campos requeridos.';
	} else if (!imageFile || imageFile.size === 0) {
		error = 'Debes subir una imagen de portada.';
	} else if (!pdfFile || pdfFile.size === 0) {
		error = 'Debes subir un archivo PDF.';
	} else {
		const img_key = imageKey(slug, imageFile.name);
		const pdf_key = pdfKey(slug);

		await uploadFile(BUCKET, img_key, imageFile);
		await uploadFile(BUCKET, pdf_key, pdfFile);

		await createArticle(DB, {
			slug, order_num,
			title_es, title_en,
			description_es, description_en,
			image_key: img_key, image_alt_es, image_alt_en,
			pdf_key,
		});

		saved = true;
	}
}
---

<!doctype html>
<html lang="es">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Nuevo artículo — Admin</title>
	{(!authorized || saved) && <script is:inline>window.location.replace('/admin');</script>}
	<style>
		*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
		body { font-family: system-ui, sans-serif; background: #1a2028; color: #e8e4df; min-height: 100vh; }
		.topbar {
			background: #242c36;
			border-bottom: 1px solid #2e3844;
			padding: 1rem 2rem;
			display: flex;
			align-items: center;
			gap: 1rem;
		}
		.back { font-size: 0.8rem; color: #8a9099; text-decoration: none; }
		.back:hover { color: #b8956a; }
		h1 { font-size: 1rem; font-weight: 300; letter-spacing: 0.08em; text-transform: uppercase; }
		main { padding: 2rem; max-width: 760px; margin: 0 auto; }
		.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
		.field { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1.25rem; }
		label { font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: #8a9099; }
		label span { color: #e57373; margin-left: 0.2rem; }
		input, textarea, select {
			background: #242c36;
			border: 1px solid #3a4452;
			color: #e8e4df;
			padding: 0.65rem 0.9rem;
			font-size: 0.875rem;
			outline: none;
			font-family: inherit;
			transition: border-color 0.2s;
			width: 100%;
		}
		input:focus, textarea:focus { border-color: #b8956a; }
		input[type="file"] { padding: 0.5rem 0.9rem; }
		textarea { min-height: 120px; resize: vertical; }
		.section-title {
			font-size: 0.7rem;
			letter-spacing: 0.12em;
			text-transform: uppercase;
			color: #b8956a;
			border-bottom: 1px solid #2e3844;
			padding-bottom: 0.5rem;
			margin-bottom: 1.25rem;
			margin-top: 1.5rem;
		}
		.error { color: #e57373; font-size: 0.85rem; background: #3d2020; padding: 0.75rem 1rem; margin-bottom: 1.5rem; }
		.actions { display: flex; gap: 1rem; margin-top: 2rem; }
		.btn {
			padding: 0.65rem 1.75rem;
			font-size: 0.8rem;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			cursor: pointer;
			text-decoration: none;
			border: none;
			transition: opacity 0.2s;
		}
		.btn-primary { background: #b8956a; color: white; }
		.btn-ghost { background: transparent; color: #8a9099; border: 1px solid #3a4452; }
		.btn:hover { opacity: 0.8; }
		.note { font-size: 0.75rem; color: #5a6470; margin-top: 0.3rem; }
	</style>
</head>
<body>
	<header class="topbar">
		<a href="/admin" class="back">← Artículos</a>
		<h1>Nuevo artículo</h1>
	</header>

	<main>
		{error && <div class="error">{error}</div>}

		<form method="POST" enctype="multipart/form-data">

			<p class="section-title">General</p>

			<div class="grid-2">
				<div class="field">
					<label for="slug">Slug (URL) <span>*</span></label>
					<input type="text" id="slug" name="slug" required placeholder="nombre-del-articulo" pattern="[a-z0-9\-]+" />
					<span class="note">Solo letras minúsculas, números y guiones</span>
				</div>
				<div class="field">
					<label for="order_num">Orden <span>*</span></label>
					<input type="number" id="order_num" name="order_num" required value="1" min="0" />
				</div>
			</div>

			<p class="section-title">Contenido en Español</p>

			<div class="field">
				<label for="title_es">Título ES <span>*</span></label>
				<input type="text" id="title_es" name="title_es" required />
			</div>
			<div class="field">
				<label for="description_es">Descripción ES <span>*</span></label>
				<textarea id="description_es" name="description_es" required placeholder="Separa párrafos con una línea en blanco"></textarea>
			</div>
			<div class="field">
				<label for="image_alt_es">Alt imagen ES <span>*</span></label>
				<input type="text" id="image_alt_es" name="image_alt_es" required />
			</div>

			<p class="section-title">Contenido en Inglés (opcional — si se deja vacío, se usa el español como fallback)</p>

			<div class="field">
				<label for="title_en">Título EN</label>
				<input type="text" id="title_en" name="title_en" />
			</div>
			<div class="field">
				<label for="description_en">Descripción EN</label>
				<textarea id="description_en" name="description_en"></textarea>
			</div>
			<div class="field">
				<label for="image_alt_en">Alt imagen EN</label>
				<input type="text" id="image_alt_en" name="image_alt_en" />
			</div>

			<p class="section-title">Archivos</p>

			<div class="grid-2">
				<div class="field">
					<label for="image">Imagen de portada <span>*</span></label>
					<input type="file" id="image" name="image" required accept=".jpg,.jpeg,.png,.webp" />
					<span class="note">JPG, PNG o WebP</span>
				</div>
				<div class="field">
					<label for="pdf">Archivo PDF <span>*</span></label>
					<input type="file" id="pdf" name="pdf" required accept=".pdf" />
					<span class="note">PDF para descarga</span>
				</div>
			</div>

			<div class="actions">
				<button type="submit" class="btn btn-primary">Crear artículo</button>
				<a href="/admin" class="btn btn-ghost">Cancelar</a>
			</div>
		</form>
	</main>
</body>
</html>
